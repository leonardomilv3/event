# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente do Eventing Frontend
#
# IMPORTANTE: variáveis com prefixo VITE_ são injetadas em tempo de BUILD,
# não em tempo de execução do container. O valor é embutido no bundle JS
# pelo Vite durante `npm run build`.
#
# Para Docker: passe via --build-arg ao construir a imagem.
#   docker build --build-arg VITE_API_URL=https://api.eventing.com.br .
#
# Para desenvolvimento local: copie este arquivo para .env.local e ajuste.
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# URL base do backend Quarkus
# Desenvolvimento local:  http://localhost:8080
# Staging:               https://api.staging.eventing.com.br
# Production:            https://api.eventing.com.br
VITE_API_URL=http://localhost:8080
